<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="TortasApp.MainWindow"
        Title="TortasApp">
    <Grid RowDefinitions="Auto, Auto, Auto, Auto" Margin="20">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, Auto">
            <StackPanel Grid.Column="0" Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="Torta" FontSize="18" FontWeight="Bold"/>
                <ListBox Name="tortaListBox">
                    <ListBoxItem Content="Paquete kids"/>
                    <ListBoxItem Content="Jalapeño"/>
                    <ListBoxItem Content="Italiana"/>
                    <ListBoxItem Content="Jamón"/>
                    <ListBoxItem Content="Ninguno"/>
                </ListBox>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="Refresco" FontSize="18" FontWeight="Bold"/>
                <ListBox Name="refrescoListBox">
                    <ListBoxItem Content="Chico"/>
                    <ListBoxItem Content="Mediano"/>
                    <ListBoxItem Content="Grande"/>
                    <ListBoxItem Content="Ninguno"/>
                </ListBox>
            </StackPanel>
            
            <StackPanel Grid.Column="2" Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="Postres" FontSize="18" FontWeight="Bold"/>
                <ListBox Name="postreListBox">
                    <ListBoxItem Content="Galletas"/>
                    <ListBoxItem Content="Pay de queso"/>
                    <ListBoxItem Content="Nieve"/>
                    <ListBoxItem Content="Ninguno"/>
                </ListBox>
            </StackPanel>
        </Grid>
        
        <StackPanel Grid.Row="1" Margin="0,20" HorizontalAlignment="Center">
            <Button Content="Calcular pago" Name="calcularButton" Width="150" Height="35"/>
        </StackPanel>
        
        <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto" Name="obsequioGrid" IsEnabled="False">
            <TextBlock Grid.Column="0" Text="Obsequio:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1">
                <ComboBoxItem Content="Paquete Avengers"/>
                <ComboBoxItem Content="Paquete Barbie"/>
                <ComboBoxItem Content="Paquete Sorpresa"/>
            </ComboBox>
        </Grid>
        
        <Grid Grid.Row="3" ColumnDefinitions="Auto,100" Margin="350,10,0,0" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Text="Subtotal:" Grid.Row="0"/>
            <TextBox Grid.Row="0" Grid.Column="1" Name="subtotalTextBox" IsEnabled="False"/>
            <TextBlock Text="IVA:" Grid.Row="1"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="ivaTextBox" IsEnabled="False"/>
            <TextBlock Text="Total:" Grid.Row="2"/>
            <TextBox Grid.Row="2" Grid.Column="1" Name="totalTextBox" IsEnabled="False"/>

        </Grid>
    </Grid>
</Window>
