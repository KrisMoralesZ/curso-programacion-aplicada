<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Crud_APP.MainWindow"
        Title="Crud_APP">
        <StackPanel Margin="20">
                <TextBox Name="nameInput" Watermark="Nombre" />
                <TextBox Name="ageInput" Watermark="Edad" />

                <Button Name="addButton" Content="Agregar" />
                <Button Name="updateButton" Content="Actualizar" />
                <Button Name="deleteButton" Content="Eliminar" />

                <ListBox Name="peopleList" Height="200"/>
        </StackPanel>

</Window>
