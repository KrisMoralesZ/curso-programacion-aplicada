<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TempCalculator.MainWindow"
        Title="TempCalculator">
        <StackPanel Margin="20" Spacing="10">
                <TextBlock Text="Ingrese temperatura" />
                <TextBox Name="txtValor" Width="150"/>

                <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Name="btnCtoF" Content="°C → °F" Width="100"/>
                        <Button Name="btnFtoC" Content="°F → °C" Width="100"/>
                </StackPanel>

                <TextBlock Name="lblResultado" FontWeight="Bold"/>
        </StackPanel>
</Window>
