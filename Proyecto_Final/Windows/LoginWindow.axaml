<Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Proyecto_Final.Windows.LoginWindow" Width="400" Height="250">
    <StackPanel Margin="20">
        <TextBlock Text="Usuario"/>
        <TextBox x:Name="UserBox"/>
        <TextBlock Text="Contraseña" Margin="0,10,0,0"/>
        <TextBox x:Name="Contraseña"/>
        <Button Content="Entrar" Click="Login_Click" Margin="0,20,0,0"/>
    </StackPanel>
</Window>