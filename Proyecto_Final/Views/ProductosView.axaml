<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Proyecto_Final.Views.ProductosView">

    <StackPanel Margin="20">

        <TextBlock Text="Productos" FontSize="20"/>

        <DataGrid x:Name="TablaProductos" Height="200" Margin="0,10"/>

        <TextBox x:Name="TxtProducto" Watermark="Producto"/>
        <TextBox x:Name="TxtDescripcion" Watermark="Descripción"/>
        <NumericUpDown x:Name="NumCantidad" Watermark="Cantidad"/>
        <NumericUpDown x:Name="NumPrecio" Watermark="Precio"/>

        <StackPanel Orientation="Horizontal" Margin="10">
            <Button Content="Agregar" Click="Agregar_Click" Width="100" />
            <Button Content="Actualizar" Click="Actualizar_Click" Margin="10,0" Width="100" />
            <Button Content="Eliminar" Click="Eliminar_Click" Width="100" />
        </StackPanel>

    </StackPanel>
</UserControl>