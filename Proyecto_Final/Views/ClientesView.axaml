<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Proyecto_Final.Views.ClientesView">

    <StackPanel Margin="20">

        <TextBlock Text="Clientes" FontSize="20" />

        <TextBox x:Name="TxtNombre" Watermark="Nombre"/>
        <TextBox x:Name="TxtDomicilio" Watermark="Domicilio"/>
        <TextBox x:Name="TxtTelefono" Watermark="Teléfono"/>
        <TextBox x:Name="TxtCorreo" Watermark="Correo"/>

        <StackPanel Orientation="Horizontal" Margin="0,10">
            <Button Content="Agregar" Click="Agregar_Click" Width="100" />
            <Button Content="Actualizar" Click="Actualizar_Click" Margin="10,0" Width="100" />
            <Button Content="Eliminar" Click="Eliminar_Click" Width="100" />
        </StackPanel>
        
        <ListBox x:Name="TablaClientes" Margin="0,20,0,0" />
        
    </StackPanel>
</UserControl>