<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Proyecto_Final.Views.ReportesView">

    <StackPanel Margin="20">

        <TextBlock Text="Reporte de Ventas" FontSize="20"/>

        <DatePicker x:Name="FechaInicio"/>
        <DatePicker x:Name="FechaFin" Margin="0,10,0,0"/>

        <Button Content="Generar TXT" Click="GenerarReporte_Click" />

    </StackPanel>
</UserControl>